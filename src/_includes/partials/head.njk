<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ p.seo.title if p and p.seo else site.title }}</title>
<meta name="description" content="{{ p.seo.description if p and p.seo else site.description }}">
<meta name="theme-color" content="{{ site.theme_color }}">
<meta name="format-detection" content="telephone=no">
<link rel="icon" href="/assets/icons/favicon.ico" sizes="32x32">
<link rel="icon" href="/assets/icons/crest.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png">
<link rel="stylesheet" href="/assets/css/main.css">
<link rel="expect" href="#site-menu" blocking="render">
<script>
  (function (d) {
    d.classList.add("anim-ready");
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) d.classList.add("anim-reduced");
    // a link to a section opens on it: the first frame waits for the section and is already there (the browser's own jump
    // comes a frame later), with no smooth scroll down from the top past sections still waiting to reveal
    var entry = performance.getEntriesByType && performance.getEntriesByType("navigation")[0];
    if (location.hash.length > 1 && (!entry || entry.type === "navigate")) {
      var expect = document.createElement("link");
      expect.rel = "expect";
      expect.setAttribute("href", location.hash);
      expect.setAttribute("blocking", "render");
      document.head.appendChild(expect);
      d.style.scrollBehavior = "auto";
      addEventListener("pagereveal", function () {
        var target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (target) target.scrollIntoView();
      }, { once: true });
      addEventListener("load", function () { d.style.scrollBehavior = ""; });
    }
    {% if p and p.preloader %}
    if (!d.classList.contains("anim-reduced")) {
      // a reload would otherwise land mid-page after the preloader has measured the hero at the top
      history.scrollRestoration = "manual";
      d.classList.add("is-preloading");
      setTimeout(function () { if (!d.hasAttribute("data-preloader-live")) d.classList.remove("is-preloading"); }, 5000);
    }
    {% endif %}
    // the arriving side of the page transition (transition.js), before the first frame: the entrance is the transition
    addEventListener("pagereveal", function (e) {
      var t = e.viewTransition;
      if (!t) return;
      d.classList.add("page-arrival");
      // this page stays out of the capture and draws itself, live, beneath the old one as it opens (_transition.less);
      // it takes its name back as it leaves (transition.js), to be captured as the page going
      d.style.viewTransitionName = "none";
      window.pageOpening = t.ready.then(null, function () {});
      window.pageArrival = t.finished;
      d.classList.remove("is-preloading");
      if (self.navigation && navigation.activation && navigation.activation.navigationType === "traverse") t.types.add("back");
      d.querySelectorAll("[data-vt-named]").forEach(function (el) {
        el.style.viewTransitionName = "";
        el.removeAttribute("data-vt-named");
      });
      // a page left from the open menu had no scrollbar thumb, so this one's waits for the circle to land and fades in
      try {
        if (sessionStorage.getItem("page-thumb") === "hidden") {
          d.style.setProperty("--scrollbar-thumb", "transparent");
          t.finished.then(function () { d.style.removeProperty("--scrollbar-thumb"); });
        }
      } catch (err) {}
    });
    // the page left hands on its scrollbar's width, so the transition can crop the blank strip out of its snapshot, and
    // whether its thumb was showing (read on every reveal: a page brought back by the back button is not loaded again)
    addEventListener("pageswap", function () {
      try {
        sessionStorage.setItem("page-scrollbar", Math.ceil(innerWidth - d.getBoundingClientRect().width) + "px");
        sessionStorage.setItem("page-thumb", d.classList.contains("is-locked") || d.classList.contains("is-preloading") ? "hidden" : "shown");
      } catch (err) {}
    });
    addEventListener("pagereveal", function () {
      try { d.style.setProperty("--page-scrollbar", sessionStorage.getItem("page-scrollbar") || "0px"); } catch (err) {}
    });
    addEventListener("load", function () {
      setTimeout(function () { if (!d.hasAttribute("data-anim-live")) d.classList.remove("anim-ready"); }, 800);
    });
  })(document.documentElement);
</script>
<noscript><style>[data-anim]{visibility:visible !important}</style></noscript>
