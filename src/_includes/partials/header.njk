<header class="site-header" data-anim="sequence" data-anim-tier="hero" data-anim-order="1" data-anim-stagger="0.12" data-anim-arrival="static">
  <div class="site-header__bar">
    <div class="site-header__quick" data-anim-item="drop-soft">
      <div class="quick-links" data-disclosure>
        <button class="quick-links__toggle" type="button" aria-expanded="false" aria-controls="quick-links-panel">
          <span data-label="{{ site.quick_links_label }}">{{ site.quick_links_label }}</span>
          <svg class="icon" aria-hidden="true"><use href="#icon-chevron-down"></use></svg>
        </button>
        <ul class="quick-links__panel" id="quick-links-panel">
          {% for item in site.quick_links %}
          <li><a{% if item.url %} href="{{ item.url }}"{% endif %}>{{ item.label }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <div class="site-header__brand" data-anim-item="drop-soft">
      <a class="site-header__logo" href="/index.html" aria-label="{{ site.name }} home">
        <img class="site-header__crest" src="/assets/icons/crest.svg" alt="" width="100" height="100">
        <img class="site-header__wordmark" src="/assets/icons/wordmark.svg" alt="" width="75" height="20">
      </a>
    </div>
    <div class="site-header__tools" data-anim-item="drop-soft">
      {% for item in site.utility_links %}
      <a class="site-header__link"{% if item.url %} href="{{ item.url }}"{% endif %}>{{ item.label }}</a>
      {% endfor %}
      <button class="site-header__menu" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-menu" data-menu-open>
        <span class="menu-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
