<section class="news-hero">
  <div class="news-hero__intro">
    <h1 data-anim="sequence" data-anim-tier="hero" data-anim-order="0" data-anim-stagger="0.3" data-anim-landed="1.35">
      <span data-anim-item="enter-left">{{ value.title_line_1 }}</span>
      <span data-anim-item="enter-left">{{ value.title_line_2 }}</span>
    </h1>
    <p data-anim="reveal" data-anim-type="fade-up" data-anim-tier="hero" data-anim-order="1">{{ value.lead }}</p>
  </div>

  <div class="news-hero__feature" data-slider-scope data-anim="reveal" data-anim-type="fade" data-anim-tier="hero" data-anim-order="1">
    <div class="swiper news-hero__slider" data-slider data-slider-mode="fade">
      <div class="swiper-wrapper">
        {% for story in value.stories %}
        <a class="swiper-slide news-hero__story" href="{{ story.url | default('#') }}">
          {% set img = story.image %}{% set cls = "news-hero__img" %}{% if loop.first %}{% set loading = "eager" %}{% endif %}{% include "snippets/image.njk" %}
          <span class="news-hero__copy">
            <span class="news-hero__tag"><span aria-hidden="true">#</span>{{ story.tag }}</span>
            <span class="news-hero__title">{{ story.title }}</span>
          </span>
        </a>
        {% endfor %}
      </div>
    </div>
    <div class="news-hero__nav">
      <button class="news-hero__arrow" type="button" data-slider-prev aria-label="Previous story"><svg class="icon" aria-hidden="true"><use href="#icon-arrow"></use></svg></button>
      <button class="news-hero__arrow" type="button" data-slider-next aria-label="Next story"><svg class="icon" aria-hidden="true"><use href="#icon-arrow"></use></svg></button>
    </div>
  </div>

  <div class="news-hero__side" data-anim="reveal" data-anim-type="glide-right" data-anim-scroll="timed">
    {% set img = value.image %}{% set cls = "news-hero__side-img" %}{% set loading = "lazy" %}{% include "snippets/image.njk" %}
  </div>

  <div class="news-hero__connect" data-anim="reveal" data-anim-type="fade-up">
    <div class="news-hero__connect-text">
      <h2>{{ value.connect.title }}</h2>
      <p>{{ value.connect.text }}</p>
    </div>
    <ul class="news-hero__links">
      {% for item in site.socials %}
      <li><a class="news-hero__link" href="{{ item.url }}" aria-label="{{ item.label }}"><svg class="icon" aria-hidden="true"><use href="#icon-{{ item.network }}"></use></svg></a></li>
      {% endfor %}
    </ul>
  </div>
</section>
