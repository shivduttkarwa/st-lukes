<section class="page-links">
  <div class="container">
    <div class="page-links__grid" data-anim-group="rise" data-anim-scroll="timed" data-anim-stagger="0.075">
      {% for card in value.cards %}
      <a class="page-links__card" href="{{ card.url | default('#') }}"{% if card.video %} data-hover-video{% endif %}>
        {% set img = card.image %}{% set cls = "page-links__img" %}{% include "snippets/image.njk" %}
        {% if card.video %}<video class="page-links__video" data-src="{{ card.video.src }}" muted loop playsinline preload="none" aria-hidden="true"></video>{% endif %}
        <span class="page-links__body">
          <span class="page-links__title">{{ card.title }}</span>
          {% if card.text %}<span class="page-links__more"><span class="page-links__text">{{ card.text }}</span></span>{% endif %}
        </span>
        <span class="page-links__arrow" aria-hidden="true"><svg class="icon"><use href="#icon-arrow-corner"></use></svg></span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
