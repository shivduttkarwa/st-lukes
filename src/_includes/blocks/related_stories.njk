<section class="related-stories">
  <div class="container">
    <div class="related-stories__head">
      <h2 data-anim="split" data-anim-type="lines" data-anim-scroll-mobile="timed">{{ value.title }}</h2>
      <div data-anim="reveal" data-anim-type="fade-up" data-anim-after-title>{% set btn = value.button %}{% set plain = true %}{% include "snippets/button.njk" %}</div>
    </div>
    <div class="news-grid" data-anim-group="rise" data-anim-scroll="timed" data-anim-stagger="0.075">
      {% for card in value.stories %}{% include "snippets/news-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
