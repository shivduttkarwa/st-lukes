<section class="article-hero">
  <div class="article-hero__card">
    <img class="article-hero__img" src="{{ value.image.src }}" alt="{{ value.image.alt }}" width="{{ value.image.width }}" height="{{ value.image.height }}" fetchpriority="high" decoding="async">
    <div class="article-hero__copy">
      <div class="article-hero__meta" data-anim="reveal" data-anim-type="fade-up" data-anim-tier="hero" data-anim-order="1">
        <p class="article-hero__tag"><span aria-hidden="true">#</span>{{ value.tag }}</p>
        <p class="article-hero__date">{{ value.date }}</p>
      </div>
      <h1 data-anim="split" data-anim-type="lines" data-anim-tier="hero" data-anim-order="0">{{ value.title }}</h1>
    </div>
  </div>
</section>
