<section class="learning" data-slider-scope>
  <div class="container">
    <div class="learning__head">
      <h2 data-anim="split" data-anim-type="lines"><span>{{ value.title_line_1 }}</span> <span class="learning__outline">{{ value.title_line_2 }}</span></h2>
      <div class="learning__nav" data-anim="reveal" data-anim-type="fade">
        <button class="learning__arrow learning__arrow--prev" type="button" aria-label="Previous" data-slider-prev><svg class="icon" aria-hidden="true"><use href="#icon-arrow-corner"></use></svg></button>
        <button class="learning__arrow" type="button" aria-label="Next" data-slider-next><svg class="icon" aria-hidden="true"><use href="#icon-arrow-corner"></use></svg></button>
      </div>
    </div>
    <div class="learning__slider swiper" data-slider data-slider-gap="6">
      <div class="swiper-wrapper" data-anim-group="fade">
        {% for card in value.cards %}
        <a class="entry swiper-slide" href="{{ card.url | default('#') }}"{% if card.video %} data-hover-video{% endif %}>
          {% set img = card.image %}{% set cls = "entry__img" %}{% include "snippets/image.njk" %}
          {% if card.video %}<video class="entry__video" data-src="{{ card.video.src }}" muted loop playsinline preload="none" aria-hidden="true"></video>{% endif %}
          <span class="entry__shade" aria-hidden="true"></span>
          <span class="entry__body">
            <h3>{{ card.title }}</h3>
            <span class="entry__meta">{{ card.meta }}</span>
            {% if card.text %}<span class="entry__more"><span class="entry__text">{{ card.text }}</span></span>{% endif %}
          </span>
          <span class="entry__arrow" aria-hidden="true"><svg class="icon"><use href="#icon-arrow-corner"></use></svg></span>
        </a>
        {% endfor %}
      </div>
    </div>
    {% if value.button %}
    <div class="learning__action" data-anim="reveal" data-anim-type="fade-up">{% set btn = value.button %}{% set plain = true %}{% include "snippets/button.njk" %}</div>
    {% endif %}
  </div>
</section>
