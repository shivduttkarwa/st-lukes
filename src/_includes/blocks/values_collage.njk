<section class="values">
  <div class="container values__grid">
    <div class="values__frame" data-anim="reveal" data-anim-type="glide-right" data-anim-scroll="timed">
      {% set img = value.image %}{% set cls = "values__img" %}{% include "snippets/image.njk" %}
    </div>
    <div class="values__side">
      <p class="values__words" data-anim-group="fade-up">
        {% for line in value.lines %}
        <span class="values__line values__line--{{ line.shift | default('centre') }}">
          {% for word in line.words %}<span class="values__word values__word--{{ word.size }}{% if word.outline %} values__word--outline{% endif %}{% if word.wide %} values__word--wide{% endif %}{% if word.align == 'centre' %} values__word--centre{% endif %}">{{ word.text }}</span> {% endfor %}
        </span>
        {% endfor %}
      </p>
      {% if value.button %}
      <div data-anim="reveal" data-anim-type="fade-up">{% set btn = value.button %}{% set plain = true %}{% include "snippets/button.njk" %}</div>
      {% endif %}
    </div>
  </div>
</section>
