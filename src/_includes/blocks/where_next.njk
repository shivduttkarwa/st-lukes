<section class="where-next{% if value.tight %} where-next--tight{% endif %}{% if value.flush %} where-next--flush{% endif %}">
  <div class="container">
    <div class="where-next__grid" data-anim="sequence" data-anim-type="fade" data-anim-scroll="timed" data-anim-stagger="0.15" data-anim-delay="0.4" data-anim-mobile="each">
      <h2 data-anim="split" data-anim-type="lines" data-anim-scroll="timed"><span>{{ value.title_line_1 }}</span> <span class="where-next__outline">{{ value.title_line_2 }}</span></h2>
      {% for card in value.cards %}
      {% if loop.first %}
      <a class="where-next__card where-next__card--lead"{% if card.url %} href="{{ card.url }}"{% endif %} data-anim-item data-anim-duration="1" data-anim-scroll="timed">
        {% set img = card.image %}{% set cls = "where-next__img" %}{% include "snippets/image.njk" %}
        <span class="where-next__title">{{ card.title }}</span>
        <span class="where-next__arrow" aria-hidden="true"><svg class="icon"><use href="#icon-arrow"></use></svg></span>
      </a>
      {% endif %}
      {% endfor %}
      <div class="where-next__side">
        {% for card in value.cards %}
        {% if not loop.first %}
        <a class="where-next__card"{% if card.url %} href="{{ card.url }}"{% endif %} data-anim-item data-anim-duration="1" data-anim-scroll="timed">
          {% set img = card.image %}{% set cls = "where-next__img" %}{% include "snippets/image.njk" %}
          <span class="where-next__title">{{ card.title }}</span>
        </a>
        {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="where-next__menu" data-anim="reveal" data-anim-type="fade-up">
      <h2><span>{{ value.menu.title_line_1 }}</span> <span class="where-next__menu-outline">{{ value.menu.title_line_2 }}</span></h2>
      <div class="where-next__row">
        <ul class="where-next__links">
          {% for link in value.menu.links %}
          <li><a class="where-next__link{% if link.current %} is-current{% endif %}"{% if link.url %} href="{{ link.url }}"{% endif %}{% if link.current %} aria-current="page"{% endif %}><span>{{ link.label }}</span></a></li>
          {% endfor %}
        </ul>
        <div class="where-next__actions">
          {% for btn in value.menu.buttons %}{% set plain = true %}{% include "snippets/button.njk" %}{% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
