<section class="social{% if value.spaced %} social--spaced{% endif %}" data-slider-scope data-social data-anim-titles-first="off">
  <div class="container">
    <div class="social__head">
      <h2 data-anim="split" data-anim-type="lines">{{ value.title_line_1 }} <span class="social__outline">{{ value.title_line_2 }}</span></h2>
      <div class="social__nav" data-anim="reveal" data-anim-type="fade-up" data-anim-after-title>
        <button class="social__arrow" type="button" aria-label="Previous" data-slider-prev><svg class="icon" aria-hidden="true"><use href="#icon-arrow-corner"></use></svg></button>
        <button class="social__arrow" type="button" aria-label="Next" data-slider-next><svg class="icon" aria-hidden="true"><use href="#icon-arrow-corner"></use></svg></button>
      </div>
    </div>
    <div class="social__slider swiper" data-slider data-slider-gap="6">
      <div class="swiper-wrapper" data-anim-group="rise" data-anim-scroll="timed" data-anim-stagger="0.075">
        {% for post in value.posts %}
        {% if value.popup %}
        <button class="social__tile swiper-slide" type="button" aria-haspopup="dialog" data-social-open{% if post.video %} data-hover-video{% endif %}>
        {% else %}
        <div class="social__tile swiper-slide"{% if post.video %} data-hover-video{% endif %}>
        {% endif %}
          {% set img = post.image %}{% set cls = "social__img" %}{% include "snippets/image.njk" %}{% if post.video %}<video class="social__video" data-src="{{ post.video.src }}" muted loop playsinline preload="none" aria-hidden="true"></video>{% endif %}
        {% if value.popup %}
        </button>
        {% else %}
        </div>
        {% endif %}
        {% endfor %}
      </div>
    </div>
    <div class="social__band" data-anim="reveal" data-anim-type="fade-up">
      <p class="social__follow">{{ value.follow_text }}</p>
      <ul class="social__links">
        {% for item in site.socials %}
        <li><a class="social__link"{% if item.url %} href="{{ item.url }}" target="_blank" rel="noopener"{% endif %} aria-label="{{ item.label }}"><svg class="icon" aria-hidden="true"><use href="#icon-{{ item.network }}"></use></svg></a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  {% if value.popup %}
  <dialog class="social__popup" aria-label="Instagram post" data-social-popup data-lenis-prevent>
    <div class="social__scrim" data-social-close></div>
    <button class="social__close" type="button" aria-label="Close" data-social-close><span class="menu-icon" aria-hidden="true"></span></button>
    <div class="social__frame">
      <button class="social__step" type="button" aria-label="Previous post" data-social-prev><svg class="icon" aria-hidden="true"><use href="#icon-arrow-corner"></use></svg></button>
      <div class="social__card">
        {% for post in value.posts %}
        <article class="social__post" hidden>
          <div class="social__media">
            {% set img = post.image %}{% set cls = "social__photo" %}{% include "snippets/image.njk" %}
            {% if post.video %}<video class="social__clip" data-src="{{ post.video.src }}" poster="{{ post.image.src }}" controls playsinline preload="none"></video>{% endif %}
          </div>
          <div class="social__body">
            <p class="social__account">
              <span class="social__avatar">{% set img = value.account.avatar %}{% set cls = "social__avatar-img" %}{% include "snippets/image.njk" %}</span>
              <a class="social__handle" href="{{ value.account.url }}" target="_blank" rel="noopener">{{ value.account.handle }}<span class="visually-hidden"> (opens in a new tab)</span></a>
            </p>
            <p class="social__caption">{{ post.caption }}</p>
            <div class="social__foot">
              <p class="social__date">{{ post.date }}</p>
              <a class="btn btn-primary btn-small social__view" href="{{ post.url }}" target="_blank" rel="noopener">{{ value.view_text }}<svg class="icon" aria-hidden="true"><use href="#icon-arrow"></use></svg><span class="visually-hidden"> (opens in a new tab)</span></a>
            </div>
          </div>
        </article>
        {% endfor %}
      </div>
      <button class="social__step" type="button" aria-label="Next post" data-social-next><svg class="icon" aria-hidden="true"><use href="#icon-arrow-corner"></use></svg></button>
    </div>
  </dialog>
  {% endif %}
</section>
