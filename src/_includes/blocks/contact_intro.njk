<section class="contact-intro" data-hero-fold=".contact-intro__top">
  <div class="container">
    <div class="contact-intro__top">
      <h2 data-anim="split" data-anim-type="lines">{{ value.title }}</h2>
      <div class="contact-intro__lead">
        <div class="contact-intro__text" data-anim-group="fade-up" data-anim-after-title>{{ value.text | safe }}</div>
        <div class="contact-intro__actions" data-anim-group="fade-up" data-anim-after-title>
          {% for btn in value.buttons %}{% set plain = true %}{% include "snippets/button.njk" %}{% endfor %}
        </div>
      </div>
    </div>
    <div class="contact-intro__cards" data-anim-group="rise" data-anim-scroll="timed" data-anim-stagger="0.075">
      {% for card in value.cards %}
      <article class="contact-intro__card">
        <h3>{{ card.title }}</h3>
        <p>{{ card.text }}</p>
        <div class="contact-intro__links">
          {% for link in card.links %}<a class="contact-intro__link"{% if link.url %} href="{{ link.url }}"{% endif %}>{{ link.text }}</a>{% endfor %}
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
