<section class="intro">
  <div class="intro__text">
    <div class="intro__statement" data-anim="split" data-anim-type="lines" data-anim-scroll="scrub">{{ value.statement | safe }}</div>
    {% if value.button %}
    <div data-anim="reveal" data-anim-type="fade-up" data-anim-after-title>{% set btn = value.button %}{% set plain = true %}{% include "snippets/button.njk" %}</div>
    {% endif %}
  </div>

  <div class="promo intro__promo" data-promo data-anim="reveal" data-anim-type="glide-right" data-anim-scroll="timed">
    {% set promo = value.promo %}{% include "snippets/promo.njk" %}
  </div>

  <div class="intro__feature">
    <div class="intro__frame" data-anim="reveal" data-anim-type="glide-left" data-anim-scroll="timed">
      {% set img = value.image %}{% set cls = "intro__photo" %}{% include "snippets/image.njk" %}
    </div>
    <div data-anim="reveal" data-anim-type="fade-up">{% set btn = value.image_button %}{% set plain = true %}{% include "snippets/button.njk" %}</div>
  </div>
</section>
