<section class="contact-form" id="contact-form">
  <div class="contact-form__frame" data-anim="reveal" data-anim-type="glide-right" data-anim-scroll="timed">
    {% set img = value.image %}{% set cls = "contact-form__img" %}{% include "snippets/image.njk" %}
  </div>
  <div class="contact-form__panel">
    <div class="contact-form__intro">
      <h2 data-anim="split" data-anim-type="lines">{{ value.title }}</h2>
      <p data-anim="reveal" data-anim-type="fade-up">{{ value.text }}</p>
    </div>
    <form class="contact-form__form" action="#" method="post" data-validate>
      <div class="contact-form__fields" data-anim-group="fade-up">
        {% for field in value.fields %}
        <div class="contact-form__field{% if field.half %} contact-form__field--half{% endif %}" data-field>
          <label for="contact-{{ field.name }}">{{ field.label }}</label>
          {% if field.type == "select" %}
          <div class="contact-form__select select" data-select>
            <select id="contact-{{ field.name }}" name="{{ field.name }}" required aria-describedby="contact-{{ field.name }}-error" data-error="{{ field.error }}">
              <option value="" disabled selected hidden>{{ field.placeholder }}</option>
              {% for option in field.options %}<option>{{ option }}</option>{% endfor %}
            </select>
            <svg class="icon" aria-hidden="true"><use href="#icon-angle-down"></use></svg>
          </div>
          {% elif field.type == "textarea" %}
          <span class="contact-form__control"><textarea id="contact-{{ field.name }}" name="{{ field.name }}" placeholder="{{ field.placeholder }}" rows="4" required aria-describedby="contact-{{ field.name }}-error" data-error="{{ field.error }}"></textarea></span>
          {% else %}
          <span class="contact-form__control"><input id="contact-{{ field.name }}" name="{{ field.name }}" type="{{ field.type }}" placeholder="{{ field.placeholder }}" required aria-describedby="contact-{{ field.name }}-error" data-error="{{ field.error }}"{% if field.invalid %} data-invalid="{{ field.invalid }}"{% endif %}{% if field.pattern %} pattern="{{ field.pattern }}"{% endif %}></span>
          {% endif %}
          <p class="contact-form__error" id="contact-{{ field.name }}-error" hidden><svg class="icon" aria-hidden="true"><use href="#icon-alert"></use></svg><span data-error-text></span></p>
        </div>
        {% endfor %}
      </div>
      <button class="btn btn-primary" type="submit" data-anim="reveal" data-anim-type="fade-up">{{ value.button }}</button>
      <p class="contact-form__success" role="status" data-form-success hidden>{{ value.success }}</p>
    </form>
  </div>
</section>
