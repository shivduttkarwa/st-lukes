{% if player and card.video %}
<article class="entry entry--player swiper-slide" data-hover-video data-video-card>
{% else %}
<a class="entry swiper-slide"{% if card.url %} href="{{ card.url }}"{% endif %}{% if card.video %} data-hover-video{% endif %}>
{% endif %}
  {% set img = card.image %}{% set cls = "entry__img" %}{% include "snippets/image.njk" %}
  {% if card.video %}<video class="entry__video" data-src="{{ card.video.src }}" muted loop playsinline preload="none" aria-hidden="true"></video>{% endif %}
  <span class="entry__shade" aria-hidden="true"></span>
  <span class="entry__body">
    <h3>{{ card.title }}</h3>
    <span class="entry__meta">{{ card.meta }}</span>
    {% if card.text %}<span class="entry__more" data-entry-more><span class="entry__text">{{ card.text }}</span></span>{% endif %}
  </span>
{% if player and card.video %}
  <button class="entry__arrow" type="button" aria-label="Play video: {{ card.title }}" data-video-toggle><svg class="icon entry__play" aria-hidden="true"><use href="#icon-{{ icon }}"></use></svg><span class="entry__close" aria-hidden="true"></span></button>
</article>
{% else %}
  <span class="entry__arrow" aria-hidden="true"><svg class="icon"><use href="#icon-{{ icon }}"></use></svg></span>
</a>
{% endif %}
