<article class="pillars__card pillars__card--{{ n }}" data-anim-group="fade-up">
  <div class="pillars__media" data-anim="reveal" data-anim-type="{{ reveal }}" data-anim-type-mobile="rise-far" data-anim-distance="0.5">
    <div class="pillars__layer">
      <div class="pillars__frame">
        {% set img = card.image %}{% set cls = "pillars__img" %}{% include "snippets/image.njk" %}
        {% if card.video %}<video class="pillars__video" src="{{ card.video.src }}" muted loop playsinline preload="none" data-ambient aria-hidden="true"></video>{% endif %}
      </div>
    </div>
  </div>
  <div class="pillars__body">
    <h3>{{ card.title }}</h3>
    <div class="pillars__copy">
      <p>{{ card.text }}</p>
      {% if card.logo %}{% set img = card.logo %}{% set cls = "pillars__logo" %}{% include "snippets/image.njk" %}{% endif %}
    </div>
  </div>
  {% set btn = card.button %}{% set plain = true %}{% include "snippets/button.njk" %}
</article>
