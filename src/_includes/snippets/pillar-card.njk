<article class="pillars__card pillars__card--{{ n }}"{% if card.video %} data-hover-video{% endif %}>
  <div class="pillars__media" data-anim-parallax-trigger>
    <div class="pillars__layer" data-anim="parallax" data-anim-centered data-anim-speed="4.55">
      {% set img = card.image %}{% set cls = "pillars__img" %}{% include "snippets/image.njk" %}
      {% if card.video %}<video class="pillars__video" data-src="{{ card.video.src }}" muted loop playsinline preload="none" aria-hidden="true"></video>{% endif %}
    </div>
  </div>
  <div class="pillars__body">
    <h3>{{ card.title }}</h3>
    <div class="pillars__copy">
      <p>{{ card.text }}</p>
      {% if card.logo %}{% set img = card.logo %}{% set cls = "pillars__logo" %}{% include "snippets/image.njk" %}{% endif %}
    </div>
  </div>
  {% set btn = card.button %}{% set plain = true %}{% include "snippets/button.njk" %}
</article>
