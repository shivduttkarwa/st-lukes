<article class="usp swiper-slide"{% if card.video %} data-hover-video{% endif %}>
  <div class="usp__media">
    {% set img = card.image %}{% set cls = "usp__img" %}{% include "snippets/image.njk" %}
    {% if card.video %}<video class="usp__video" data-src="{{ card.video.src }}" muted loop playsinline preload="none" aria-hidden="true"></video>{% endif %}
  </div>
  <div class="usp__body">
    <h3>{{ card.title }}</h3>
    <p>{{ card.text }}</p>
  </div>
  {% if card.link and card.link.text %}<a class="usp__link"{% if card.link.url %} href="{{ card.link.url }}"{% endif %}>{{ card.link.text }}<svg class="icon" aria-hidden="true"><use href="#icon-arrow-corner"></use></svg></a>{% endif %}
</article>
